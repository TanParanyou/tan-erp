{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tan-erp.local/schemas/flow.schema.json",
  "title": "tan-erp documentation flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "description", "groups", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "document": { "type": "string", "minLength": 1 },
    "illustration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "$ref": "#/$defs/localizedText" }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "order", "title", "summary", "icon", "phase", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "group": { "$ref": "#/$defs/id" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "$ref": "#/$defs/localizedText" },
          "summary": { "$ref": "#/$defs/localizedText" },
          "icon": { "$ref": "#/$defs/id" },
          "phase": { "enum": ["phase-0", "phase-1", "phase-2", "future"] },
          "status": { "enum": ["accepted", "draft", "future"] },
          "document": { "type": "string", "minLength": 1 },
          "details": {
            "type": "array",
            "items": { "$ref": "#/$defs/localizedText" }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "type"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/localizedText" },
          "type": { "enum": ["required", "approval", "return", "optional"] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": {
        "th": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
