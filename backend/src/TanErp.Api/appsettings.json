{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Audit": {
    "RedactedKeys": [ "email", "phone", "mobile", "address", "taxId", "nationalId", "displayName", "firstName", "lastName", "fullName" ],
    "RetentionDays": null
  },
  "ApprovalLimits": {
    "Seed": []
  },
  "AccessBootstrap": {
    "Enabled": false
  },
  "ItemImportJobs": {
    "Enabled": true,
    "BatchSize": 100,
    "PollIntervalSeconds": 5,
    "LeaseMinutes": 10
  },
  "MembershipExpiryReminder": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "StartupDelaySeconds": 60,
    "MaxMembershipsPerRun": 200,
    "ThresholdDays": [ 30, 7, 1 ]
  }
}
