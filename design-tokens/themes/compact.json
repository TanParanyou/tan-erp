{
  "density": {
    "cell-pad-y": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Compact density: tighter table rows",
      "$extensions": {
        "tanerp": {
          "css": "erp-cell-pad-y",
          "webOnly": true
        }
      }
    }
  },
  "size": {
    "control": {
      "height": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "Compact control height override",
        "$extensions": {
          "tanerp": {
            "css": "erp-control-height"
          }
        }
      }
    }
  }
}
