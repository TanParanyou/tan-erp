# ==============================================================================
# TanErp Production & Staging Environment Configuration Template
# Copy this file to .env.production or pass via your secret manager / CI pipeline
# WARNING: Do NOT commit real production passwords or secret keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=tan_erp
POSTGRES_USER=tan_erp_user
# REQUIRED (compose fails if empty). Use a strong, randomly generated alphanumeric password (e.g., openssl rand -base64 32)
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptographic Keys
# ------------------------------------------------------------------------------
# REQUIRED (compose fails if empty). Must be at least 32 characters long for HMAC-SHA256 signing
JWT_SIGNING_KEY=
# REQUIRED (compose fails if empty). Must be at least 32 characters long for AES-GCM secret protection
ENCRYPTION_KEY=
# Optional: Google OAuth 2.0 Client ID for Google Workspace SSO
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. Application Networking & Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=5179
FRONTEND_PORT=3000

# Public URLs used by client-side browser and reverse proxy
NEXT_PUBLIC_APP_URL=https://erp.example.com
# Set to full API URL (e.g., https://api.erp.example.com) or leave empty if reverse-proxied under same origin (/api)
NEXT_PUBLIC_API_BASE_URL=https://api.erp.example.com
# Comma-separated list of allowed origins for media/attachments
NEXT_PUBLIC_MEDIA_ALLOWED_ORIGINS=https://erp.example.com,https://api.erp.example.com
# Allowed CORS origins for the backend API (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=https://erp.example.com

# ------------------------------------------------------------------------------
# 4. QuestPDF Licensing (PDF Generation Engine)
# ------------------------------------------------------------------------------
# Default false. Set to 'true' only once business confirms compliance with QuestPDF Community license
# (< $1M annual gross revenue & non-public/non-government) or provide commercial key
QUESTPDF_LICENSE_CONFIRMED=false

# ------------------------------------------------------------------------------
# 5. Outbound SMS Gateway (Acceptance OTP Challenges)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
# Supported providers: thaibulksms, twilio, webhook
SMS_PROVIDER=thaibulksms
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NAME=TanERP
SMS_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 6. Accounting System Connector & Journal Export
# ------------------------------------------------------------------------------
ACCOUNTING_CONNECTOR_ENABLED=false
# Supported providers: local, peak, flowaccount, webhook
ACCOUNTING_CONNECTOR_PROVIDER=local
ACCOUNTING_CONNECTOR_ENDPOINT_URL=
ACCOUNTING_CONNECTOR_API_KEY=

# ------------------------------------------------------------------------------
# 7. ETDA e-Tax Invoice XML Digital Signature (RSA-SHA256)
# ------------------------------------------------------------------------------
# Host folder holding the PKCS#12 (.p12/.pfx) certificate; mounted read-only at /etc/tan-erp/etax
ETAX_CERTIFICATE_HOST_DIR=./secrets/etax
# Path INSIDE the container, e.g. /etc/tan-erp/etax/etax.p12 (leave empty to disable signing)
ETAX_CERTIFICATE_PATH=
ETAX_CERTIFICATE_PASSWORD=
